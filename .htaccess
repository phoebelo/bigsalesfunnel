# Big Sales Funnel - Apache / cPanel settings
# Upload this file to public_html together with the site files.

# ---- Custom 404 page ----
ErrorDocument 404 /404.html

# ---- Force HTTPS and non-www (single redirect) ----
# Turn on SSL first (cPanel > SSL/TLS Status > Run AutoSSL), otherwise visitors will see a certificate warning.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://bigsalesfunnel.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- Default document ----
DirectoryIndex index.html

# ---- Compression ----
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# ---- Browser caching for static assets ----
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
<FilesMatch "\.(css|js|png|jpg|jpeg|webp|svg|ico)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>

# ---- Basic security headers ----
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---- Keep repo/config files private ----
<FilesMatch "^(\.cpanel\.yml|\.gitignore|README\.md)$">
Require all denied
</FilesMatch>
Options -Indexes
